{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ],
  "functions": {
    "app.py": {
      "excludeFiles": "{train.py,data/**,dataset/**,*.zip,*.tar.gz,**/__pycache__/**,*.csv}"
    }
  }
}
